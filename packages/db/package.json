    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@the-right-party/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3"
